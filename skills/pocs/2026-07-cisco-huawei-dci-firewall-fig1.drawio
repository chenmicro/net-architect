<mxCell id="lg_solid_t" value="Physical link (leaf-spine mesh in light gray; thick: M-LAG peer-link)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#000000;" vertex="1" parent="legend">
  <mxGeometry x="72" y="10" width="420" height="20" as="geometry"/>
</mxCell>
<mxCell id="lg_color_t" value="Blue: core, spine · Green: leaf · Red: firewall · Gray: server. Solid box: data center; dashed box: CloudFabric fabric managed by iMaster NCE-Fabric. Names carry the DC number (DC2: Border2-1, FW2, Core2, ...)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#000000;" vertex="1" parent="legend">
  <mxGeometry x="16" y="34" width="1128" height="20" as="geometry"/>
</mxCell>
<mxCell id="lg_note_t" value="Data center 2 mirrors Data center 1 (DC2 links in 172.16.200.0/24). EXT link addresses shown; the FW also has a VPC-A and a VPC-B sub-interface, and all interconnection subnets differ. Each firewall is off-path, attached to the border-leaf M-LAG pair by a single-chassis LACP EtherChannel, and peers BGP with each member&#x27;s M-LAG IP (.3, .4) on the VBDIF; no PBR. The cores are Huawei switches not managed by iMaster NCE-Fabric; they peer eBGP with the EXT VRF and carry Layer 3 between the DCs, and each DC has its own egress. The DCI leaf pairs connect over a dedicated cross-DC link. Point-to-point links use 172.16.0.0/16; service subnets 10.0.0.0/8." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#000000;" vertex="1" parent="legend">
  <mxGeometry x="16" y="56" width="1128" height="30" as="geometry"/>
</mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
