# Installed by `npm install` in mcp/doc-fetcher — reproducible from
# package.json/package-lock.json, not meant to be version-controlled.
node_modules/

# npm's crash log from a failed install/run; local debugging noise only.
npm-debug.log*

# Finder's per-directory metadata cache on macOS; contributor-machine-specific.
.DS_Store

# Holds real API keys (BRAVE_API_KEY, FIRECRAWL_API_KEY); never commit secrets.
# Copy .env.example to .env and fill in your own values.
.env

# Local uv Python toolchain for mcp-server-fetch — installed per clone, not
# version-controlled.
.uv/

# Presentation exports are local-only. The editable, uncompressed .drawio XML
# is the canonical diagram artifact tracked by this repository.
*.drawio.svg

# Generated only while building the GitHub Pages artifact.  Draw.io exports
# are written beside their canonical sources so relative links stay stable.
**/_figures/
/.pages-build/
/.pages-site/

# Generated by the Python utilities and their test/lint tooling.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
